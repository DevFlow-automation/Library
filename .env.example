# Supabase (все запросы идут только с сервера через service_role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Авторизация админ-панели (только сервер)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
# Секрет подписи сессий админа и учеников (минимум 16 символов, например: openssl rand -hex 32)
ADMIN_SESSION_SECRET=replace-with-a-random-32-byte-hex-secret
